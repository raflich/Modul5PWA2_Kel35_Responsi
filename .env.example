# TentCraft PWA — Environment Variables
# Salin berkas ini ke .env jika ingin menghubungkan dengan REST API eksternal / Supabase

# Opsi Backend Supabase (Opsional)
# VITE_API_BASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Secara default, TentCraft bekerja 100% offline-first menggunakan LocalStorage & In-Memory SWR Cache
